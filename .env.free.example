# Copy only the needed entries into .env.local. Never commit the real API key.
# The dedicated API Host comes from the QWeather console; do not use the old shared host.
QWEATHER_API_HOST=
QWEATHER_API_KEY=
QWEATHER_LANGUAGE=zh
QWEATHER_UNIT=metric
QWEATHER_TIMEOUT_MS=10000
QWEATHER_RETRY_COUNT=1

# Open-Meteo free access does not require a key.
OPEN_METEO_ENABLED=true
OPEN_METEO_MODE=free
OPEN_METEO_BASE_URL=https://api.open-meteo.com
OPEN_METEO_MODEL_LIST=best_match,gfs_seamless
OPEN_METEO_MODEL_LIST_LIMIT=2
OPEN_METEO_API_KEY=
OPEN_METEO_CUSTOMER_ENDPOINT=

# Public requests are same-origin. Keep keys on the API server.
NEXT_PUBLIC_API_BASE_URL=/api/service

# Amap: use the existing admin geo:amap record, or these API-server env values.
# JS API key is different from the old Web Service key. Never expose securityJsCode.
ENABLE_REAL_AMAP=false
AMAP_JS_API_KEY=
AMAP_SECURITY_JS_CODE=
# The dev:free script enables an OSM preview only in development without Amap credentials.
# Production always uses Amap; missing credentials do not activate another basemap.
