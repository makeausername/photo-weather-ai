{
  "name": "photo-weather-ai",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "type": "module",
  "scripts": {
    "setup:free-local": "node scripts/free-local-db.mjs setup",
    "stop:free-db": "node scripts/free-local-db.mjs stop",
    "dev:free": "node scripts/dev-free-local.mjs",
    "dev": "pnpm -r --parallel --if-present dev",
    "dev:astro": "python -m uvicorn app.main:app --host 127.0.0.1 --port 4100 --app-dir apps/astro-service",
    "dev:local": "powershell -ExecutionPolicy Bypass -File scripts/dev-local.ps1",
    "stop:local": "powershell -ExecutionPolicy Bypass -File scripts/stop-local.ps1",
    "check:local": "powershell -ExecutionPolicy Bypass -File scripts/check-local.ps1",
    "debug:astro": "powershell -ExecutionPolicy Bypass -File scripts/debug-astro-local.ps1",
    "debug:weather": "powershell -ExecutionPolicy Bypass -File scripts/debug-weather-providers.ps1",
    "test-provider": "pnpm --filter @photo-weather/api test-provider",
    "test:astro-api": "powershell -ExecutionPolicy Bypass -File scripts/test-astro-forecast-api.ps1",
    "test:qweather": "powershell -ExecutionPolicy Bypass -File scripts/test-qweather-provider.ps1",
    "test:weather-fusion": "powershell -ExecutionPolicy Bypass -File scripts/test-weather-fusion.ps1",
    "calibration:test": "bash scripts/test-historical-calibration.sh",
    "bortle:calibrate": "pnpm --filter @photo-weather/api bortle:calibrate",
    "sky-darkness:diagnose": "pnpm --filter @photo-weather/api sky-darkness:diagnose",
    "sky-darkness:stats": "bash scripts/sample-national-sky-darkness.sh",
    "sky-darkness:benchmark": "pnpm --filter @photo-weather/api sky-darkness:benchmark",
    "sky-darkness:qa": "bash scripts/report-sky-darkness-qa.sh",
    "build": "pnpm -r --workspace-concurrency=1 --if-present build",
    "db:generate": "pnpm --filter @photo-weather/db db:generate",
    "db:migrate": "pnpm --filter @photo-weather/db db:migrate",
    "db:push": "pnpm --filter @photo-weather/db db:push",
    "db:seed": "pnpm --filter @photo-weather/db db:seed",
    "db:seed:free": "pnpm --filter @photo-weather/db db:seed:free",
    "db:studio": "pnpm --filter @photo-weather/db db:studio",
    "bootstrap:admin": "pnpm --filter @photo-weather/db bootstrap:admin",
    "create-admin": "pnpm --filter @photo-weather/db create-admin",
    "verify-admin": "pnpm --filter @photo-weather/db verify-admin",
    "lint": "eslint . --ext .js,.cjs,.mjs,.ts,.tsx --max-warnings=0",
    "typecheck": "pnpm -r --workspace-concurrency=1 --if-present typecheck",
    "test": "pnpm -r --workspace-concurrency=1 --if-present test",
    "mobile:audit": "node scripts/audit-mobile-layout.mjs",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "8.57.0",
    "@types/node": "20.12.12",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "eslint": "8.57.0",
    "eslint-config-prettier": "9.1.0",
    "prettier": "3.2.5",
    "tsx": "4.10.5",
    "typescript": "5.4.5",
    "vitest": "1.6.0"
  },
  "pnpm": {
    "overrides": {
      "form-data@<2.5.6": "2.5.6",
      "fast-xml-parser@<4.5.5": "4.5.5",
      "postcss@<8.5.31": "8.5.31",
      "nanoid@>=3 <3.3.18": "3.3.18",
      "source-map-js@<1.2.2": "1.2.2",
      "fast-uri@>=2 <2.4.8": "2.4.8",
      "fast-uri@>=3 <3.1.9": "3.1.9",
      "proxy-addr@<2.0.8": "2.0.8",
      "ajv@>=8 <8.18.0": "8.18.0",
      "qs@<6.16.0": "6.16.0"
    }
  }
}
