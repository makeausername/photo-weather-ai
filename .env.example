NODE_ENV=development

# Windows local development through an SSH tunnel:
DATABASE_URL="postgresql://photo_weather_ai:CHANGE_ME@127.0.0.1:15432/photo_weather_ai?schema=public"
# Replace this placeholder with a local-only value of at least 32 characters before login testing.
JWT_SECRET="change-this-local-dev-secret"
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000"

# Docker Compose local database example:
# DATABASE_URL=postgresql://photo_weather:photo_weather@postgres:5432/photo_weather_ai
REDIS_URL=redis://redis:6379
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_DAYS=30
ADMIN_AUTH_BYPASS=false
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-long-random-password
ADMIN_DISPLAY_NAME=Super Admin
ADMIN_RESET_PASSWORD=false

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_DEFAULT_MODEL=deepseek-v4-flash
ENABLE_REAL_DEEPSEEK=false
AMAP_API_KEY=
AMAP_WEB_SERVICE_KEY=
AMAP_BASE_URL=https://restapi.amap.com
ENABLE_REAL_AMAP=false
# Local/test default stays mock. Use WEATHER_PROVIDER_MODE=fixture only for local fixture adapter validation.
WEATHER_PROVIDER=mock
WEATHER_PROVIDER_MODE=mock
QWEATHER_API_KEY=
QWEATHER_API_HOST=https://devapi.qweather.com
QWEATHER_BASE_URL=https://devapi.qweather.com
QWEATHER_TIMEOUT_MS=8000
QWEATHER_RETRY_COUNT=1
OPEN_METEO_API_KEY=
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_CUSTOMER_ENDPOINT=
OPEN_METEO_DEFAULT_MODEL=forecast
OPEN_METEO_TIMEOUT_MS=8000
OPEN_METEO_RETRY_COUNT=1

STORAGE_PROVIDER=local
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
TENCENT_COS_SECRET_ID=
TENCENT_COS_SECRET_KEY=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

SENTRY_DSN=
