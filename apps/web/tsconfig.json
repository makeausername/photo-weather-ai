{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "incremental": true,
    "jsx": "preserve",
    "noEmit": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next-free/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next-production-check/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
